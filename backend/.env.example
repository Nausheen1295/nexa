# Copy to .env (never commit .env) or set these in your host's dashboard.

# Required. Stays on the server — never put it in the website.
ANTHROPIC_API_KEY=

# Model id from your LLM provider (required)
NEXA_MODEL=
# low is plenty for chat; raise to medium/high if answers need more depth
NEXA_EFFORT=low
NEXA_MAX_TOKENS=2048
# server-side refusal fallback (provider feature)
NEXA_FALLBACKS=true

# Only these sites may call the API from a browser
NEXA_ALLOWED_ORIGINS=https://nausheen1295.github.io,http://localhost:8000
# questions per visitor, per minute and per day
NEXA_RATE_LIMIT=10
NEXA_RATE_LIMIT_DAY=200
# true when running behind a hosting proxy (Render/Fly/Railway) so the real visitor IP is used
NEXA_TRUST_PROXY=true
